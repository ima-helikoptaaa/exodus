DATABASE_URL="postgresql://exodus:exodus_dev@localhost:5432/exodus?schema=public"

# LLM configuration (OpenAI-compatible API — used for resume tailoring + job scoring)
# For GLM-5.2 local: http://localhost:8000/v1
# For Zhipu cloud:  https://open.bigmodel.cn/api/paas/v4
LLM_API_BASE_URL="http://localhost:8000/v1"
LLM_API_KEY=""
LLM_MODEL="glm-5.2"

# Bedrock fallback — if the GLM endpoint is unreachable, scoring/resume calls
# transparently fall back to Claude Sonnet on AWS Bedrock (default provider
# chain credentials). Set BEDROCK_FALLBACK_DISABLED=true to surface GLM errors
# instead of falling back.
AWS_REGION="us-east-1"
BEDROCK_MODEL_ID="us.anthropic.claude-sonnet-4-6"
BEDROCK_FALLBACK_DISABLED=""

# Path to portals.yml (defaults to probing ../scripts/portals.yml,
# scripts/portals.yml, ../../scripts/portals.yml relative to cwd)
# PORTALS_CONFIG_PATH="/path/to/portals.yml"

# Scout tuning
# SCOUT_SCORING_CONCURRENCY=6   # concurrent LLM scoring calls
# SCOUT_OUTAGE_THRESHOLD=8      # fallbacks before a run is marked degraded
